---
import Container from "./Container.astro";
---
<div id="solution">
    <Container>
      <div class="space-y-6 justify-between text-gray-600 md:flex flex-row-reverse md:gap-6 md:space-y-0 lg:gap-12 lg:items-center">
        
        <!-- Image: constrained width on large screens -->
        <div class="md:w-5/12 lg:w-[42%] xl:w-[38%]">
          <img
            src="./images/pie.svg"
            alt="Nutrition insights chart"
            loading="lazy"
            class="w-full"
          />
        </div>

        <!-- Text content -->
        <div class="md:w-7/12 lg:w-1/2">
          <h2 class="text-3xl font-bold text-gray-900 md:text-4xl dark:text-white">
            Tailored insights, designed for you.
          </h2>
          <p class="my-8 text-gray-600 dark:text-gray-300">
            One test. A complete picture of your nutrition.<br><br>
            The Alia Health app turns your results into clear, actionable guidance. No medical background needed. See exactly where you stand, what's changed, and what to do next.
          </p>
          <div class="divide-y space-y-4 divide-gray-100 dark:divide-gray-800">

            <!-- Fully Personalised -->
            <div class="mt-8 flex gap-4 md:items-center">
              <div class="w-12 h-12 flex gap-4 rounded-full bg-indigo-100 dark:bg-indigo-900/20 flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 m-auto text-indigo-500 dark:text-indigo-400">
                  <path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0021.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 003.065 7.097A9.716 9.716 0 0012 21.75a9.716 9.716 0 006.685-2.653zm-12.54-1.285A7.486 7.486 0 0112 15a7.486 7.486 0 015.855 2.812A8.224 8.224 0 0112 20.25a8.224 8.224 0 01-5.855-2.438zM15.75 9a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="w-5/6">
                <h3 class="font-semibold text-lg text-gray-700 dark:text-indigo-300">Fully Personalised</h3>
                <p class="text-gray-500 dark:text-gray-400">Your results, your recommendations. Alia adapts to your goals, diet, and lifestyle. Guidance that works for you.</p>
              </div>
            </div>

            <!-- Fully Secure -->
            <div class="pt-4 flex gap-4 md:items-center">
              <div class="w-12 h-12 flex gap-4 rounded-full bg-teal-100 dark:bg-teal-900/20 flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 m-auto text-teal-600 dark:text-teal-400">
                  <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="w-5/6">
                <h3 class="font-semibold text-lg text-gray-700 dark:text-teal-300">Fully Secure</h3>
                <p class="text-gray-500 dark:text-gray-400">You own your data. Everything is fully encrypted and GDPR compliant. Never sold, never shared. Your health information stays yours.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </Container>
</div>
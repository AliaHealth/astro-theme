---
import Container from "./Container.astro"
---
<div class="text-gray-600 dark:text-gray-300" id="reviews">
  <Container>
    <div class="mb-20 space-y-4 px-6 md:px-0">
      <h2 class="text-center text-2xl font-bold text-gray-800 dark:text-white md:text-4xl">
        Built by engineers, grounded in research.
      </h2>
    </div>
    <div class="grid grid-cols-2 gap-8 max-w-3xl mx-auto">
      <div class="aspect-auto p-8 border border-gray-100 rounded-3xl bg-white dark:bg-gray-800 dark:border-gray-700 shadow-2xl shadow-gray-600/10 dark:shadow-none">
        <div class="flex gap-4">
          <img class="w-12 h-12 rounded-full" src="./images/avatars/avatar.webp" alt="user avatar" width="400" height="400" loading="lazy">
          <div>
            <h5 class="text-lg font-medium text-gray-700 dark:text-white"><b>Samuel Sanderson</b></h5>
            <p class="text-sm text-gray-500 dark:text-gray-300">CEO & Founder</p>
          </div>
        </div>
        <p class="mt-8">Biomedical engineer and ex-consultant for private equity-backed businesses.</p>
      </div>
      <div class="aspect-auto p-8 border border-gray-100 rounded-3xl bg-white dark:bg-gray-800 dark:border-gray-700 shadow-2xl shadow-gray-600/10 dark:shadow-none">
        <div class="flex gap-4">
          <img class="w-12 h-12 rounded-full" src="./images/avatars/avatar-1.webp" alt="user avatar" width="200" height="200" loading="lazy">
          <div>
            <h6 class="text-lg font-medium text-gray-700 dark:text-white"><b>Nick Gaussen</b></h6>
            <p class="text-sm text-gray-500 dark:text-gray-300">CTO</p>
          </div>
        </div>
        <p class="mt-8">CTO & Full-stack developer for news & medical data. Ex-Bright Sites & Desktop Genetics.</p>
      </div>
    </div>
  </Container>

  <Container>
    <div class="mt-16 mb-10 space-y-4 px-6 md:px-0">
      <h2 class="text-center text-2xl font-bold text-gray-800 dark:text-white md:text-4xl">
        With world-class advisors
      </h2>
    </div>
    <div class="grid grid-cols-2 gap-8 max-w-3xl mx-auto">
      <div class="aspect-auto p-8 border border-gray-100 rounded-3xl bg-white dark:bg-gray-800 dark:border-gray-700 shadow-2xl shadow-gray-600/10 dark:shadow-none">
        <div class="flex gap-4">
          <img class="w-12 h-12 rounded-full" src="./images/avatars/avatar.webp" alt="user avatar" width="400" height="400" loading="lazy">
          <div>
            <h6 class="text-lg font-medium text-gray-700 dark:text-white">Dr Lasith Ranasinghe</h6>
            <p class="text-sm text-gray-500 dark:text-gray-300">NHS Doctor</p>
          </div>
        </div>
        <p class="mt-8">Multi-award-winning doctor, published medical author and personal trainer.</p>
      </div>
      <div class="aspect-auto p-8 border border-gray-100 rounded-3xl bg-white dark:bg-gray-800 dark:border-gray-700 shadow-2xl shadow-gray-600/10 dark:shadow-none">
        <div class="flex gap-4">
          <img class="w-12 h-12 rounded-full" src="./images/avatars/avatar-1.webp" alt="user avatar" width="200" height="200" loading="lazy">
          <div>
            <h6 class="text-lg font-medium text-gray-700 dark:text-white">Tony Cass, DPhil</h6>
            <p class="text-sm text-gray-500 dark:text-gray-300">CTO</p>
          </div>
        </div>
        <p class="mt-8"></p>
      </div>
    </div>
  </Container>
</div>
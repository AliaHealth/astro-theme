---
import Container from "./Container.astro"
---
<div class="text-gray-600" id="reviews">
  <Container>
    <div class="mb-20 space-y-4 px-6 md:px-0">
      <h2 class="text-center text-2xl font-bold text-gray-800 md:text-4xl">
        Built by engineers, grounded in research.
      </h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-3xl mx-auto">
      <div class="aspect-auto p-8 border border-gray-100 rounded-3xl bg-white shadow-2xl shadow-gray-600/10">
        <div class="flex gap-4">
          <img class="w-12 h-12 rounded-full" src="./images/sam.jpg" alt="user avatar" width="400" height="400" loading="lazy">
          <div>
            <h5 class="text-lg font-medium text-gray-700"><b>Samuel Sanderson</b></h5>
            <p class="text-sm text-gray-500">CEO & Founder</p>
          </div>
        </div>
        <p class="mt-8">Biomedical engineer and ex-consultant for private equity-backed businesses.</p>
      </div>
      <div class="aspect-auto p-8 border border-gray-100 rounded-3xl bg-white shadow-2xl shadow-gray-600/10">
        <div class="flex gap-4">
          <img class="w-12 h-12 rounded-full" src="./images/nick.jpg" alt="user avatar" width="200" height="200" loading="lazy">
          <div>
            <h6 class="text-lg font-medium text-gray-700"><b>Nick Gaussen</b></h6>
            <p class="text-sm text-gray-500">CTO</p>
          </div>
        </div>
        <p class="mt-8">CTO & Full-stack developer for news & medical data. Ex-Bright Sites & Desktop Genetics.</p>
      </div>
    </div>
  </Container>

  <Container>
    <div class="mt-16 mb-10 space-y-4 px-6 md:px-0">
      <h2 class="text-center text-2xl font-bold text-gray-800 md:text-4xl">
        With world-class advisors
      </h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-3xl mx-auto">
      <div class="aspect-auto p-8 border border-gray-100 rounded-3xl bg-white shadow-2xl shadow-gray-600/10">
        <div class="flex gap-4">
          <img class="w-12 h-12 rounded-full" src="./images/lasith.png" alt="user avatar" width="400" height="400" loading="lazy">
          <div>
            <h6 class="text-lg font-medium text-gray-700">Dr Lasith Ranasinghe</h6>
            <p class="text-sm text-gray-500">NHS Doctor</p>
          </div>
        </div>
        <p class="mt-8">Multi-award-winning doctor, published medical author and personal trainer. Creator of the flagship "Beyond Calories" Talk. </p>
      </div>
      <div class="aspect-auto p-8 border border-gray-100 rounded-3xl bg-white shadow-2xl shadow-gray-600/10">
        <div class="flex gap-4">
          <img class="w-12 h-12 rounded-full" src="./images/tony.jpg" alt="user avatar" width="200" height="200" loading="lazy">
          <div>
            <h6 class="text-lg font-medium text-gray-700">Dr Tony Cass, DPhil</h6>
            <p class="text-sm text-gray-500">Professor Emeritus, ICL</p>
          </div>
        </div>
        <p class="mt-8">Professor Emeritus of Analytical Chemistry and Chemical Biology, 150+ papers; Pioneered CGM technology used by Abbott.</p>
      </div>
      <div class="aspect-auto p-8 border border-gray-100 rounded-3xl bg-white shadow-2xl shadow-gray-600/10">
        <div class="flex gap-4">
          <img class="w-12 h-12 rounded-full" src="./images/georgi.png" alt="user avatar" width="400" height="400" loading="lazy">
          <div>
            <h6 class="text-lg font-medium text-gray-700">Dr Georgi Petkov, PhD</h6>
            <p class="text-sm text-gray-500">Research Leader, GATE Institute</p>
          </div>
        </div>
        <p class="mt-8">Research Lead of the Digital Health R&D unit of GATE institute, with two decades of experience in biomedical engineering & health technology.</p>
      </div>
      <div class="aspect-auto p-8 border border-gray-100 rounded-3xl bg-white shadow-2xl shadow-gray-600/10">
        <div class="flex gap-4">
          <img class="w-12 h-12 rounded-full" src="./images/fiona.jpg" alt="user avatar" width="400" height="400" loading="lazy">
          <div>
            <h6 class="text-lg font-medium text-gray-700">Fiona Reid</h6>
            <p class="text-sm text-gray-500">Head of Programme, UCL</p>
          </div>
        </div>
        <p class="mt-8">Ex-CERN, Godlman Sachs, Phillips; Founder & Director of Oxford Centre for Entrepreneurship and Innovation; Associate Professor & Head of Program at UCL.</p>
      </div>
    </div>
  </Container>
</div>
---
import Container from "./Container.astro";
---

<footer class="py-20 md:py-32 border-t border-gray-100 dark:border-gray-800" id="footer">
    <Container>
      <div class="m-auto md:w-10/12 lg:w-8/12 xl:w-6/12">
        <div class="flex flex-wrap items-start justify-between md:flex-nowrap gap-12">
          
          <!-- Left: Nav links -->
          <div class="w-full sm:w-auto">
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-6">Navigation</p>
            <ul class="space-y-4 text-gray-600 dark:text-gray-300">
              <li><a href="/#home" class="transition hover:text-primary">Home</a></li>
              <li><a href="/#features" class="transition hover:text-primary">About</a></li>
              <li><a href="/solution" class="transition hover:text-primary">Solution</a></li>
              <li><a href="/#reviews" class="transition hover:text-primary">Team</a></li>
              <li><a href="mailto:hello@aliahealth.eu" class="transition hover:text-primary">Contact</a></li>
            </ul>
          </div>

          <!-- Middle: Social links -->
          <div class="w-full sm:w-auto">
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-6">Connect</p>
            <ul class="space-y-4 text-gray-600 dark:text-gray-300">
              <li>
                <a href="https://linkedin.com/company/aliahealth" target="_blank" class="flex items-center gap-3 transition hover:text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  <span>LinkedIn</span>
                </a>
              </li>
              <li>
                <a href="https://aliahealth.eu" target="_blank" class="flex items-center gap-3 transition hover:text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253M3 12a8.959 8.959 0 01.284-2.253" />
                  </svg>
                  <span>aliahealth.eu</span>
                </a>
              </li>
              <li>
                <a href="mailto:hello@aliahealth.eu" class="flex items-center gap-3 transition hover:text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25H4.5a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5H4.5a2.25 2.25 0 00-2.25 2.25m19.5 0l-9.75 6.75L2.25 6.75" />
                  </svg>
                  <span>hello@aliahealth.eu</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Right: Map + Address -->
          <div class="w-full sm:w-auto sm:max-w-xs">
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-6">Find us</p>
            
            <!-- Embedded map -->
            <div class="rounded-2xl overflow-hidden mb-4 border border-gray-100 dark:border-gray-700">
             <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2482.9160522063125!2d-0.1235699!3d51.5147561!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4876058c7c9527fb%3A0x79bc7464573598c1!2s71-75%20Shelton%20St%2C%20London%20WC2H%209JQ!5e0!3m2!1sen!2suk!4v1781013860141!5m2!1sen!2suk" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>

            <!-- Address -->
            <address class="not-italic text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
              71-75 Shelton St<br />
              London, WC2H 9JQ<br />
              United Kingdom
            </address>
          </div>

        </div>

        <!-- Bottom bar -->
        <div class="mt-16 pt-8 border-t border-gray-100 dark:border-gray-800 text-center text-sm text-gray-400 dark:text-gray-500">
          &copy; <span id="year"></span> Alia Health. All rights reserved.
        </div>

      </div>
    </Container>
</footer>

<script>
  const yearEl = document.getElementById("year");
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
---
import Layout from '../layouts/Layout.astro';
import Container from '../components/container.astro';
---

<Layout title="Technology | Alia Health">
  <Container>
    <div class="pt-36 pb-24">

      <!-- Page Header -->
      <div class="text-center mb-20">
        <h1 class="text-gray-900 dark:text-white font-bold text-5xl md:text-6xl text-balance">
          How it <span class="text-primary">works</span>
        </h1>
        <p class="mt-4 text-gray-500 dark:text-gray-400 text-lg max-w-xl mx-auto">
          , in just three clicks.
        </p>
      </div>

      <!-- Three Step Images -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-32">

        <!-- Step 1 -->
        <div class="flex flex-col items-center text-center">
          <h3 class="text-gray-900 dark:text-white font-semibold text-xl mb-4">Step 1 — Collect</h3>
          <div class="w-full aspect-square rounded-2xl bg-gray-100 dark:bg-gray-800 overflow-hidden">
            <img
              src="/images/step1.jpg"
              alt="Collection step"
              class="w-full h-full object-cover"
            />
          </div>
          <p class="mt-4 text-gray-500 dark:text-gray-400 text-sm leading-relaxed">
            A short description of what happens in step one. Keep it simple and accessible.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="flex flex-col items-center text-center">
          <h3 class="text-gray-900 dark:text-white font-semibold text-xl mb-4">Step 2 — Analyse</h3>
          <div class="w-full aspect-square rounded-2xl bg-gray-100 dark:bg-gray-800 overflow-hidden">
            <img
              src="/images/step2.jpg"
              alt="Analysis step"
              class="w-full h-full object-cover"
            />
          </div>
          <p class="mt-4 text-gray-500 dark:text-gray-400 text-sm leading-relaxed">
            A short description of what happens in step two. Focus on the benefit to the user.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="flex flex-col items-center text-center">
          <h3 class="text-gray-900 dark:text-white font-semibold text-xl mb-4">Step 3 — Understand</h3>
          <div class="w-full aspect-square rounded-2xl bg-gray-100 dark:bg-gray-800 overflow-hidden">
            <img
              src="/images/step3.jpg"
              alt="Results step"
              class="w-full h-full object-cover"
            />
          </div>
          <p class="mt-4 text-gray-500 dark:text-gray-400 text-sm leading-relaxed">
            A short description of step three. What does the user walk away with?
          </p>
        </div>

      </div>

      <!-- Hardware Section -->
      <div class="mb-32 max-w-3xl mx-auto">
        <h2 class="text-gray-900 dark:text-white font-bold text-4xl mb-6">
          The hardware
        </h2>
        <p class="text-gray-600 dark:text-gray-300 text-lg leading-relaxed mb-4">
          Your detailed hardware description goes here. Explain the technology, the materials,
          how it was designed, and why it matters. This is where you can go deeper for the
          curious reader.
        </p>
        <p class="text-gray-600 dark:text-gray-300 text-lg leading-relaxed">
          A second paragraph if needed. Talk about accuracy, certifications, or what makes
          your approach different from existing solutions on the market.
        </p>
      </div>

      <!-- Software Section (placeholder) -->
      <div class="max-w-3xl mx-auto">
        <h2 class="text-gray-900 dark:text-white font-bold text-4xl mb-6">
          The software
        </h2>
        <p class="text-gray-600 dark:text-gray-300 text-lg leading-relaxed">
          Your software section content goes here. Coming soon.
        </p>
      </div>

    </div>
  </Container>
</Layout>